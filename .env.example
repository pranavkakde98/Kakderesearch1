# Kakde Research — serverless API environment (Vercel).
# Copy to Vercel Project Settings → Environment Variables. Never commit real keys.

# --- Transactional email (Resend) ---
# Create a key at https://resend.com and verify the sending domain (SPF + DKIM).
RESEND_API_KEY=

# Verified sender, e.g. "Kakde Research <research@kakderesearch.com>"
EMAIL_FROM=

# Reply-to shown on outgoing mail (optional; defaults to none)
EMAIL_REPLY_TO=inquiries@kakderesearch.com

# Internal inbox that receives enquiry + request notifications
INQUIRY_TO_EMAIL=inquiries@kakderesearch.com

# Absolute base URL used to build report download links in emails
APP_BASE_URL=https://www.kakderesearch.com

# --- Optional: durable rate-limit / idempotency store (production) ---
# The API ships with a best-effort in-memory limiter that resets on cold start.
# For a durable limiter across instances, provision Vercel KV / Upstash Redis
# and wire these in api/_lib/http.js.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
