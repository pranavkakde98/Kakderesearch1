# Kakde Research — serverless API environment (Vercel).
# Set these in Vercel → Project Settings → Environment Variables. Never commit real keys.

# --- Transactional email (Resend) ---
# Create a key at https://resend.com and verify the sending domain (SPF + DKIM + DMARC).
RESEND_API_KEY=
# Verified sender. (RESEND_FROM is read as an alias, for the production Vercel project.)
EMAIL_FROM=Kakde Research <research@kakderesearch.com>
# Reply-to shown on outgoing mail (optional)
EMAIL_REPLY_TO=inquiries@kakderesearch.com
# Internal inbox that receives enquiry + report-request notifications.
# (ADMIN_NOTIFICATION_EMAIL is read as an alias.)
INQUIRY_TO_EMAIL=inquiries@kakderesearch.com

# Absolute base URL used to build public links in emails and to check Origin
APP_BASE_URL=https://www.kakderesearch.com

# --- Supabase (server-side only; the service-role key never reaches the browser) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Anon key: used ONLY to call the production edge function submit-project-inquiry
# for enquiry persistence (same as production contact.js). Optional.
SUPABASE_ANON_KEY=
# Private bucket holding "Available on request" PDFs (see supabase/schema.sql)
SUPABASE_REPORTS_BUCKET=reports
# Signed-link lifetime for delivered reports (seconds; default 7 days)
REPORT_LINK_TTL_SECONDS=604800
# Set to 1 to attach the PDF to the email as well as linking it (≤24 MB)
REPORT_ATTACH=0
# Salt for hashing request IPs before storage
IP_HASH_SALT=change-me

# Optional: Google Apps Script (or similar) webhook that mirrors each enquiry and
# report request into a sheet. Leave unset to skip the mirror.
SHEETS_WEBHOOK_URL=
